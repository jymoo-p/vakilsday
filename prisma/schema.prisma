generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  ASSOCIATE
  CLERK
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CaseStatus {
  ACTIVE
  PENDING
  CLOSED
  ARCHIVED
}

enum AppearingFor {
  PETITIONER
  RESPONDENT
}

enum DocumentType {
  PETITION
  EVIDENCE
  ANNEXURE
  ORDER
  OTHER
}

enum AppointmentType {
  HEARING
  CLIENT_MEETING
  OTHER
}

model Organization {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique

  subscriptionTier String   @default("FREE")
  maxUsers         Int      @default(5)

  users            User[]
  cases            Case[]
  clients          Client[]
  customRoles      CustomRole[]
  courts           Court[]
  caseTypes        CaseType[]
  appointments     Appointment[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("organizations")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  inviteToken    String?   @unique
  inviteExpiry   DateTime?
  role           Role      @default(ASSOCIATE)
  phone          String?

  // Profile fields
  bio            String?   @db.Text
  specialization String?
  yearsOfService Int?
  joiningDate    DateTime?
  otherInfo      String?   @db.Text

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customRoleId   String?
  customRole     CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  accounts       Account[]
  sessions       Session[]

  assignedCases  CaseAssignment[]
  hearingNotes   HearingNote[]
  researchBookmarks ResearchBookmark[]
  appointments   Appointment[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@map("users")
}

model CustomRole {
  id             String   @id @default(cuid())
  name           String
  permissions    String[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  users          User[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("custom_roles")
}

model Client {
  id                String   @id @default(cuid())
  firstName         String
  lastName          String
  gender            Gender
  age               Int?
  phone             String
  otherPhone        String?
  email             String?
  address           String?   @db.Text
  lawyerNotes       String?   @db.Text

  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  cases             Case[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organizationId])
  @@index([firstName, lastName])
  @@map("clients")
}

model Court {
  id             String   @id @default(cuid())
  name           String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  cases          Case[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("courts")
}

model CaseType {
  id             String   @id @default(cuid())
  name           String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  cases          Case[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("case_types")
}

model Case {
  id              String      @id @default(cuid())
  caseNumber      String
  year            Int?
  appearingFor    AppearingFor

  clientId        String?
  client          Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)

  otherParties    String[]

  opponentMainParty String
  opponentOtherParties String[]

  courtId         String?
  court           Court?      @relation(fields: [courtId], references: [id], onDelete: SetNull)
  courtNumber     String?

  caseTypeId      String?
  caseType        CaseType?   @relation(fields: [caseTypeId], references: [id], onDelete: SetNull)

  judgeName       String?
  opposingCounselName  String?
  opposingCounselPhone String?

  status          CaseStatus  @default(ACTIVE)
  filingDate      DateTime
  nextHearingDate DateTime?

  synopsis        String?     @db.Text

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignments     CaseAssignment[]
  hearings        Hearing[]
  documents       Document[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([caseNumber, organizationId])
  @@index([organizationId])
  @@index([clientId])
  @@index([nextHearingDate])
  @@index([status])
  @@map("cases")
}

model Appointment {
  id              String          @id @default(cuid())
  title           String
  type            AppointmentType
  startTime       DateTime
  endTime         DateTime?
  location        String?
  notes           String?         @db.Text

  caseId          String?
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, startTime])
  @@index([organizationId])
  @@map("appointments")
}

model CaseAssignment {
  id        String   @id @default(cuid())
  caseId    String
  userId    String

  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([caseId, userId])
  @@index([userId]) // For fast lookup of user's assigned cases
  @@index([caseId]) // For fast lookup of case assignments
  @@map("case_assignments")
}

model Hearing {
  id              String        @id @default(cuid())
  caseId          String
  hearingDate     DateTime
  itemNumber      String?

  outcome         String?       @db.Text
  nextHearingDate DateTime?

  case            Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  notes           HearingNote[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([caseId, hearingDate])
  @@index([hearingDate]) // For fast calendar queries
  @@map("hearings")
}

model HearingNote {
  id        String   @id @default(cuid())
  hearingId String
  userId    String
  content   String   @db.Text

  isPrivate Boolean  @default(false)

  hearing   Hearing  @relation(fields: [hearingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hearing_notes")
}

model Document {
  id           String       @id @default(cuid())
  caseId       String

  title        String
  documentType DocumentType

  // Google Drive fields
  driveFileId  String?      // Google Drive file ID
  driveUrl     String?      // Shareable link
  storageUrl   String?      // Legacy field (kept for backward compatibility)

  fileSize     Int?
  mimeType     String?

  uploadedBy   String

  case         Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([caseId, documentType])
  @@map("documents")
}

model ResearchBookmark {
  id          String   @id @default(cuid())
  userId      String

  title       String
  sourceType  String
  sourceUrl   String?
  content     String   @db.Text

  tags        String[]

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("research_bookmarks")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
